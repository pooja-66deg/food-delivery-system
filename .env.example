# FastAPI Configuration
API_TITLE=Food Delivery Platform
API_VERSION=0.1.0
ENVIRONMENT=development
# Comma-separated CORS allowlist (never "*" together with credentials)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth rate limiting (fixed window, per client IP)
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_SECONDS=60
# How long an emailed password-reset link stays usable.
PASSWORD_RESET_TTL_SECONDS=900
# Where reset links point, and where Stripe returns a customer after a
# redirect — the SPA, not the API.
FRONTEND_BASE_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://fooduser:foodpass@localhost:5432/fooddelivery
DATABASE_ECHO=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# JWT Configuration
#
# Every service verifies tokens against this one value, so it must be identical
# across all seven and it must not be a default. Services refuse to start with
# ENVIRONMENT=production while this is a known dev value or shorter than 32
# characters — see shared/config_guard.py. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# Admin console access
#
# ADMIN_GATE_PASSWORD is the shared password for the gate in front of the admin
# login form. It is checked by the users service at POST /auth/admin/gate and is
# never sent to the browser — do not move it to a VITE_ variable, because Vite
# inlines those into the built bundle where anyone can read them.
#
# Unset means no gate, which is fine locally. The users service refuses to start
# in production without it. It is a deterrent, not access control: real
# perimeter control belongs at the network layer (Cloud IAP, VPN, IP allowlist).
ADMIN_GATE_PASSWORD=

# BOOTSTRAP_SECRET guards the one-time creation of the platform's first admin
# (POST /api/auth/internal/bootstrap-admin, and the admin service proxy at
# POST /api/admin/bootstrap, which forwards it as the X-Bootstrap-Secret header).
# Both routes are reachable through the public gateway, so an unset secret
# disables them rather than leaving them open. Set it on the users and admin
# services, bootstrap the first admin, then unset it.
BOOTSTRAP_SECRET=

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=food-delivery-group

# Third-party Services — all optional; features log instead of sending when unset.
# Stripe (online card payments via hosted Checkout): set STRIPE_SECRET_KEY to use
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# How long a card order may sit unpaid before it is cancelled and its stock
# reservation released.
PAYMENT_WINDOW_SECONDS=900

# Twilio (SMS). Order and delivery updates only — there is no OTP login.
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# SendGrid (email) + FCM (push)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
FCM_SERVER_KEY=

# Google Maps — server side only (Routes API for ETAs, Geocoding API to resolve
# delivery addresses to coordinates). Unset: ETAs fall back to a straight-line
# estimate and new addresses stay ungeocoded. This is a server key and must never
# be sent to the browser; the browser uses VITE_GOOGLE_MAPS_API_KEY in
# frontend/.env.
GOOGLE_MAPS_API_KEY=
# Delivery zone enforced for a geocoded restaurant that has not set its own
# radius, in km. Restaurants without coordinates fall back to a city match.
DELIVERY_DEFAULT_RADIUS_KM=10
# Assumed road speed for the fallback ETA, in km/h.
DELIVERY_AVERAGE_SPEED_KMH=25
# How long a computed ETA is cached per order, so a 5s tracking poll does not
# hit the Routes API twelve times a minute.
DELIVERY_ETA_CACHE_SECONDS=30

# Logging Configuration
LOG_LEVEL=INFO
