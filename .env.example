# FastAPI Configuration
API_TITLE=Food Delivery Platform
API_VERSION=0.1.0
ENVIRONMENT=development
# Comma-separated CORS allowlist (never "*" together with credentials)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth rate limiting (fixed window, per client IP)
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=900
EMAIL_VERIFICATION_TTL_SECONDS=86400
# Where emailed reset / verification links point — the SPA, not the API.
FRONTEND_BASE_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://fooduser:foodpass@localhost:5432/fooddelivery
DATABASE_ECHO=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRATION_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=food-delivery-group

# Third-party Services — all optional; features log instead of sending when unset.
# Stripe (online card payments via hosted Checkout): set STRIPE_SECRET_KEY to use
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# How long a card order may sit unpaid before it is cancelled and its stock
# reservation released.
PAYMENT_WINDOW_SECONDS=900

# Twilio (SMS / OTP delivery)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# SendGrid (email) + FCM (push)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
FCM_SERVER_KEY=

# Google Maps — server side only (Routes API for ETAs, Geocoding API to resolve
# delivery addresses to coordinates). Unset: ETAs fall back to a straight-line
# estimate and new addresses stay ungeocoded. This is a server key and must never
# be sent to the browser; the browser uses VITE_GOOGLE_MAPS_API_KEY in
# frontend/.env.
GOOGLE_MAPS_API_KEY=
# Delivery zone enforced for a geocoded restaurant that has not set its own
# radius, in km. Restaurants without coordinates fall back to a city match.
DELIVERY_DEFAULT_RADIUS_KM=10
# Assumed road speed for the fallback ETA, in km/h.
DELIVERY_AVERAGE_SPEED_KMH=25
# How long a computed ETA is cached per order, so a 5s tracking poll does not
# hit the Routes API twelve times a minute.
DELIVERY_ETA_CACHE_SECONDS=30

# Logging Configuration
LOG_LEVEL=INFO
