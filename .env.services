# Microservices Environment Configuration
# Used by docker-compose for multi-database and Kafka setup

# Postgres credentials (shared across all postgres services)
POSTGRES_USER=fooduser
POSTGRES_PASSWORD=foodpass

# Service database URLs
ORDERS_DATABASE_URL=postgresql://fooduser:foodpass@postgres-orders:5432/orders_db
PAYMENTS_DATABASE_URL=postgresql://fooduser:foodpass@postgres-payments:5432/payments_db
USERS_DATABASE_URL=postgresql://fooduser:foodpass@postgres-users:5432/users_db
RESTAURANTS_DATABASE_URL=postgresql://fooduser:foodpass@postgres-restaurants:5432/restaurants_db
DELIVERY_DATABASE_URL=postgresql://fooduser:foodpass@postgres-delivery:5432/delivery_db
NOTIFICATIONS_DATABASE_URL=postgresql://fooduser:foodpass@postgres-notifications:5432/notifications_db

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=food-delivery-services

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Service Configuration
JWT_SECRET_KEY=dev-secret-change-me-in-production
ENVIRONMENT=development

# Service Port Configuration
ORDERS_SERVICE_PORT=8000
PAYMENTS_SERVICE_PORT=8000
USERS_SERVICE_PORT=8000
RESTAURANTS_SERVICE_PORT=8000
DELIVERY_SERVICE_PORT=8000
NOTIFICATIONS_SERVICE_PORT=8000
ADMIN_SERVICE_PORT=8000

# API Gateway Configuration
API_GATEWAY_PORT=8080
API_GATEWAY_HOST=0.0.0.0

# Service URLs (for inter-service communication via API Gateway)
ORDERS_SERVICE_URL=http://api-gateway:8080/api/orders
PAYMENTS_SERVICE_URL=http://api-gateway:8080/api/payments
USERS_SERVICE_URL=http://api-gateway:8080/api/users
RESTAURANTS_SERVICE_URL=http://api-gateway:8080/api/restaurants
DELIVERY_SERVICE_URL=http://api-gateway:8080/api/delivery
NOTIFICATIONS_SERVICE_URL=http://api-gateway:8080/api/notifications
ADMIN_SERVICE_URL=http://api-gateway:8080/api/admin

# Database configuration per service
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Log Level
LOG_LEVEL=INFO
