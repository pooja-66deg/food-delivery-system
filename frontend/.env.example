# API base URL. Leave unset in development — Vite proxies /api to the backend
# (see vite.config.ts). Set this for production builds, e.g.:
# VITE_API_URL=https://api.your-domain.com
VITE_API_URL=/api

# Stripe publishable key (pk_test_… / pk_live_…). Leave unset to run without
# card payments: the card option is hidden and cash on delivery is the only
# method offered. The matching STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET go in
# the backend's .env.
VITE_STRIPE_PUBLISHABLE_KEY=
