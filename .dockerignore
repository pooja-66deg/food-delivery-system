# Keep build contexts small and free of host-built artifacts.
.git
.gitignore

# Python
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
htmlcov
.coverage
.coverage.*

# Node / frontend build artifacts (rebuilt inside the image)
**/node_modules
frontend/dist

# Local env & logs (secrets come from compose, not the image)
# Exception: frontend/.env contains Vite build-time env vars (VITE_*) which must be available at build time
.env
!frontend/.env
*.log

# Docs / tests are not needed at runtime — and a test suite in a production
# image is extra surface for no benefit.
docs
shared/tests
services/*/tests
